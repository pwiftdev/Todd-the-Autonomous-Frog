generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SuggestionCategory {
  WEBSITE
  PERSONALITY
  SOCIAL
  APPEARANCE
  FEATURE
  OTHER
}

enum SuggestionStatus {
  PENDING
  CONSIDERING
  ACCEPTED
  REJECTED
  MODIFIED
  IMPLEMENTED
}

enum DecisionKind {
  ACCEPT
  REJECT
  POSTPONE
  MODIFY
}

enum BrainRunStatus {
  QUEUED
  RUNNING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum BrainRunTrigger {
  CRON
  ADMIN
}

enum OutboxStatus {
  PENDING
  RUNNING
  DELIVERED
  RETRYING
  FAILED
  CANCELLED
}

enum ToddActivityKind {
  REVIEWING
  THINKING
  RESTING
}

model ToddState {
  id             String   @id @default("todd")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  currentMood    String   @default("suspicious")
  favoriteThing  String   @default("Pond")
  leastFavorite  String   @default("Being told what to do")
  autonomyPaused Boolean  @default(false)
  currentStatus  String   @default("Thinking")
  nextDecisionAt DateTime?
}

model Personality {
  id           String   @id @default("personality")
  curiosity    Int      @default(82)
  stubbornness Int      @default(76)
  chaos        Int      @default(48)
  confidence   Int      @default(86)
  friendliness Int      @default(58)
  updatedAt    DateTime @updatedAt
}

model Memory {
  id               String   @id @default(cuid())
  type             String
  content          String
  importance       Int      @default(50)
  sourceRunId      String?
  sourceDecisionId String?
  createdAt        DateTime @default(now())

  @@index([type, createdAt])
  @@index([sourceRunId])
}

model Suggestion {
  id           String             @id @default(cuid())
  text         String
  category     SuggestionCategory @default(OTHER)
  displayName  String             @default("Anonymous human")
  status       SuggestionStatus   @default(PENDING)
  supportCount Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  supports     SuggestionSupport[]
  decisions    Decision[]
  actions      Action[]
  decisionRuns DecisionRun[]

  @@index([status, createdAt])
}

model SuggestionSupport {
  id           String     @id @default(cuid())
  suggestionId String
  fingerprint  String
  createdAt    DateTime   @default(now())
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, fingerprint])
}

model Decision {
  id              String       @id @default(cuid())
  suggestionId    String
  decision        DecisionKind
  confidence      Float
  reasoningPublic String
  rawResponse     Json
  createdAt       DateTime     @default(now())
  decisionRunId   String?      @unique
  suggestion      Suggestion   @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  decisionRun     DecisionRun? @relation(fields: [decisionRunId], references: [id], onDelete: SetNull)
  actions         Action[]

  @@index([createdAt])
}

model Action {
  id            String     @id @default(cuid())
  suggestionId  String?
  decisionId    String?
  type          String
  previousValue Json
  newValue      Json
  reasoning     String
  status        String     @default("IMPLEMENTED")
  revertedAt    DateTime?
  createdAt     DateTime   @default(now())
  suggestion    Suggestion? @relation(fields: [suggestionId], references: [id])
  decision      Decision?   @relation(fields: [decisionId], references: [id])

  @@index([createdAt])
}

model SiteConfig {
  id              String   @id @default(cuid())
  parentConfigId  String?
  version         Int      @unique
  isActive        Boolean  @default(false)
  theme           String
  accent          String
  heroTitle       String
  heroSubtitle    String
  ctaCopy         String
  announcement    String?
  statusText      String
  frogMood        String
  frogAccessory   String
  enabledSections Json
  createdAt       DateTime @default(now())
  parentConfig    SiteConfig?  @relation("SiteConfigHistory", fields: [parentConfigId], references: [id], onDelete: SetNull)
  childConfigs    SiteConfig[] @relation("SiteConfigHistory")

  @@index([isActive])
  @@index([parentConfigId])
}

model Thought {
  id        String   @id @default(cuid())
  content   String
  eventType String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model SocialPost {
  id         String   @id @default(cuid())
  content    String
  provider   String   @default("mock")
  externalId String?
  status     String   @default("POSTED")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model SocialStyle {
  id             String   @id @default("social-style")
  maxLength      Int      @default(180)
  emojiFrequency String   @default("low")
  tone           String   @default("dry")
  lowercase      Boolean  @default(false)
  replyFrequency String   @default("medium")
  updatedAt      DateTime @updatedAt
}

model DailyJournal {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  event     String
  actor     String
  metadata  Json
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model AiRun {
  id            String       @id @default(cuid())
  decisionRunId String?
  attemptNumber Int          @default(1)
  operation     String
  status        String       @default("RUNNING")
  provider      String       @default("unknown")
  model         String?
  promptHash    String?
  request       Json
  response      Json?
  requestId     String?
  responseId    String?
  inputTokens   Int?
  outputTokens  Int?
  costKnown     Boolean      @default(false)
  costMicros    BigInt?
  latencyMs     Int?
  error         String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  decisionRun   DecisionRun? @relation(fields: [decisionRunId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@unique([decisionRunId, attemptNumber])
}

model DecisionRun {
  id               String          @id @default(cuid())
  idempotencyKey   String          @unique
  trigger          BrainRunTrigger
  status           BrainRunStatus  @default(QUEUED)
  suggestionId     String
  workerId         String?
  leaseToken       String?
  leaseExpiresAt   DateTime?
  attemptCount     Int             @default(0)
  maxAttempts      Int             @default(3)
  nextAttemptAt    DateTime        @default(now())
  contextSnapshot  Json?
  contextHash      String?
  promptHash       String?
  lastErrorCode    String?
  lastErrorMessage String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  suggestion       Suggestion      @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  decision         Decision?
  attempts         AiRun[]
  activity         ToddActivity?
  outboxEvents     OutboxEvent[]

  @@index([status, nextAttemptAt, createdAt])
  @@index([leaseExpiresAt])
  @@index([suggestionId, createdAt])
}

model ToddActivity {
  id            String           @id @default(cuid())
  decisionRunId String?          @unique
  type          ToddActivityKind
  location      String           @default("backend")
  reason        String
  isCurrent     Boolean          @default(true)
  startedAt     DateTime         @default(now())
  endsAt        DateTime
  createdAt     DateTime         @default(now())
  decisionRun   DecisionRun?     @relation(fields: [decisionRunId], references: [id], onDelete: SetNull)

  @@index([isCurrent, endsAt])
}

model OutboxEvent {
  id             String       @id @default(cuid())
  decisionRunId  String?
  type           String
  dedupeKey      String       @unique
  payload        Json
  status         OutboxStatus @default(PENDING)
  workerId       String?
  leaseToken     String?
  leaseExpiresAt DateTime?
  attemptCount   Int          @default(0)
  maxAttempts    Int          @default(5)
  nextAttemptAt  DateTime     @default(now())
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  decisionRun    DecisionRun? @relation(fields: [decisionRunId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt, createdAt])
  @@index([leaseExpiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @default(now()) @updatedAt

  @@index([resetAt])
}
