# Explicit runtime mode: demo, live, or test.
TODD_RUNTIME_MODE="demo"
DATABASE_URL="postgresql://todd:change-me@localhost:5432/todd?schema=public"

# Administrative and scheduler authentication. Use independent random values.
ADMIN_SECRET="change-me"
CRON_SECRET="change-this-too"
FINGERPRINT_SECRET="change-this-separately"
PUBLIC_ORIGIN="http://localhost:3000"
# Vercel overwrites this ingress header with the verified client address.
CLIENT_IP_HEADER="x-vercel-forwarded-for"

# AI_PROVIDER=mock is allowed only in demo/test. Live mode requires openai.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_BASE_URL="https://api.openai.com/v1"
# Keep false unless an explicitly approved HTTPS-compatible endpoint is used.
OPENAI_ALLOW_CUSTOM_BASE_URL="false"

# Autonomous social posting remains disabled until an approved outbox consumer exists.
SOCIAL_PROVIDER="disabled"
