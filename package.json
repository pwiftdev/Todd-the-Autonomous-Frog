{
  "name": "todd-autonomous-frog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "tsx --test lib/*.test.mjs lib/*.test.ts lib/ai/provider.test.ts lib/brain/context.test.ts lib/brain/contracts.test.ts lib/brain/routes.test.ts lib/brain/runtime.test.ts lib/brain/scheduler.test.ts lib/brain/schema.test.ts lib/security/security.test.ts",
    "test:postgres": "bash scripts/test-postgres.sh",
    "test:migration:upgrade": "bash scripts/test-migration-upgrade.sh",
    "test:postgres:existing": "tsx --test --test-concurrency=1 lib/brain/*.postgres.test.ts lib/security/*.postgres.test.ts",
    "test:all": "npm run test:unit && npm run test:postgres",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^16.3.0",
    "openai": "7.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.22",
    "prettier": "^3.6.2",
    "prisma": "^6.13.0",
    "tailwindcss": "^3.4.17",
    "three": "^0.179.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
